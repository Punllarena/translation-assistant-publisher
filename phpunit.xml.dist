<?xml version="1.0"?>
<phpunit
    bootstrap="tests/bootstrap.php"
    colors="true"
    convertDeprecationsToExceptions="false"
>
    <testsuites>
        <testsuite name="Translation Assistant Publisher">
            <directory prefix="test-" suffix=".php">tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
