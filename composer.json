{
    "name": "punllarena/translation-assistant-publisher",
    "description": "WordPress plugin that receives chapter exports from Translation Assistant.",
    "type": "wordpress-plugin",
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-phpunit/wp-phpunit": "6.6.*",
        "roots/wordpress-no-content": "6.6.*",
        "roots/wordpress-core-installer": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "roots/wordpress-core-installer": true
        }
    },
    "extra": {
        "wordpress-install-dir": "vendor/wordpress"
    }
}
